#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# LSIO remaps `abc` but shallow-chowns /config; old DB ownership otherwise causes SQLITE_READONLY.
# Dependencies run this after init-adduser and before Node opens the DB.
# Scope recursive ownership changes to /config, never large/user-owned media mounts.
# Root-squashed NFS failures must warn and continue rather than abort s6 startup.

lsiown -R abc:abc /config \
  || echo "[init-narratorr-config] WARNING: could not chown /config; DB writes may fail if ownership is wrong"
