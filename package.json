{
  "name": "narratorr",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "Todd Johnson",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:server": "tsup",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "verify": "pnpm lint && pnpm test && pnpm typecheck && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "docker:build": "docker build -t narratorr .",
    "docker:up": "docker compose up -d"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@hookform/resolvers": "^5.5.7",
    "@libsql/client": "^0.17.4",
    "@tanstack/react-query": "^5.101.4",
    "archiver": "^8.0.0",
    "cheerio": "^1.2.0",
    "croner": "^10.0.1",
    "dompurify": "^3.4.12",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "music-metadata": "^11.14.0",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-router": "^8.3.0",
    "socks-proxy-agent": "^10.1.0",
    "sonner": "^2.0.7",
    "undici": "^8.9.0",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ],
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1",
      "shell-quote@<1.8.4": ">=1.8.4",
      "@babel/core@<7.29.6": "7.29.6",
      "undici@>=7.0.0 <7.28.0": "7.28.0",
      "minimatch@>=9.0.0 <9.0.9": "9.0.9",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "ajv@>=7.0.0 <8.18.0": "8.18.0",
      "file-type@>=13.0.0 <21.3.2": "21.3.2",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.0",
      "fast-uri@<3.1.2": ">=3.1.2",
      "ip-address@<10.1.1": ">=10.1.1",
      "ws@<8.20.1": ">=8.20.1",
      "brace-expansion@>=1.0.0 <1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <5.0.8": "5.0.9"
    }
  }
}
