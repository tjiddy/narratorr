# Copy to .env and edit; .env is gitignored. All variables are optional unless noted.

# Server
# PORT=3000
# NODE_ENV=production
# CORS_ORIGIN=http://localhost:5173

# Storage
# CONFIG_PATH=./config
# DATABASE_URL=./config/narratorr.db

# Path prefix behind a reverse proxy (for example, https://host/narratorr).
# URL_BASE=/

# Credential-encryption key: 32+ random bytes, base64. Generated at <CONFIG_PATH>/secret.key when unset.
# NARRATORR_SECRET_KEY=

# DEV ONLY: bypasses every auth check; never set in production.
# AUTH_BYPASS=false

# Background poll schedule (cron; default every 30 seconds).
# MONITOR_INTERVAL_CRON=*/30 * * * * *

# REQUIRED behind a proxy when local-network bypass is enabled; otherwise proxy IPs can
# make external requests appear local and collapse per-IP rate limits.
# Accepts comma-separated IPs, CIDRs, or proxy-addr keywords: loopback, linklocal, uniquelocal.
# Unset ignores X-Forwarded-For and is safe only without a proxy.
# Trust every hop or none: @fastify/proxy-addr walks right-to-left to the first untrusted
# address, so a private intermediate can re-enable bypass for external clients.
# TRUSTED_PROXIES=10.0.0.0/8
# TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12
# TRUSTED_PROXIES=loopback
